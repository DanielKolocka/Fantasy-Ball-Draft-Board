# ─────────────────────────────────────────────────────────────
#  Fantasy Basketball Draft Board — config
#  Copy this file to `.env` and fill in the values.
#  `.env` is gitignored and never sent to the browser.
#
#  League name, teams, managers, and draft order are entered inside the
#  app (League Setup) — nothing to configure here for that. These vars
#  are only used to pull the ESPN player database (names/positions/ADP)
#  for search. The app works without them too; player search just won't.
# ─────────────────────────────────────────────────────────────

# Any ESPN league your account can see — it doesn't have to be the league
# you're actually drafting. The `leagueId=` value in its URL:
#   https://fantasy.espn.com/basketball/league?leagueId=123456
ESPN_LEAGUE_ID=

# Season year = the year that league's season ENDS in.
#   2024-25 season -> 2025      2025-26 season -> 2026
ESPN_SEASON_YEAR=

# ── Auth (needed for a private league) ───────────────────────
# In your browser, signed in to fantasy.espn.com:
#   DevTools -> Application -> Cookies -> https://fantasy.espn.com
# Copy the FULL value of each cookie.
ESPN_S2=
# SWID looks like {AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE}
# Include the braces (the app adds them if you forget).
ESPN_SWID=

# ── Optional tuning ──────────────────────────────────────────
# How often the backend refreshes the player universe / ADP (ms).
PLAYER_POLL_INTERVAL_MS=300000

# Max players to pull from kona_player_info (via X-Fantasy-Filter).
PLAYER_LIMIT=900

# Local web server port.
PORT=3000

# Set to 1 to dump the raw ESPN player response to server/sample-response.json
# on every successful poll (useful for confirming the schema).
DEBUG_DUMP=0
